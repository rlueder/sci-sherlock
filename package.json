{
  "name": "sci-sherlock",
  "private": true,
  "type": "module",
  "description": "Sherlock Holmes in The Stopped Clocks: an adventure game teaser running on sci-ts",
  "license": "MIT",
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "sci-ts build",
    "dev": "sci-ts build && vite",
    "play": "sci-ts play",
    "edit": "sci-ts edit",
    "site": "tsx site.ts",
    "art": "sci-ts art",
    "preview": "tsx preview.ts",
    "export-art": "tsx export-art.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm art check art/art.json && pnpm test",
    "voices": "tsx tts/standins.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^26.6.3",
    "sci2-ts": "^0.12.0",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  }
}
